# Wallet that deploys everything (testnet only — never a real-money key)
PRIVATE_KEY=

# Optional: the AI agent's own key/address. Defaults to the deployer.
AGENT_ADDRESS=
# Optional: an allowed "API provider" the agent pays. Defaults to the deployer.
MERCHANT_ADDRESS=

# Optional RPC overrides
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# Policy defaults
DAILY_LIMIT=50
PER_TX_CAP=10
WINDOW_SECONDS=86400
GUARD_FUND=1
WALLET_GAS_FUND=0.002

# AI agent (any OpenAI-compatible API, or anthropic)
AGENT_PRIVATE_KEY=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
